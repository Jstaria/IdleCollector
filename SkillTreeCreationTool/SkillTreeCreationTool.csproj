<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RollForward>Major</RollForward>
		<PublishReadyToRun>false</PublishReadyToRun>
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>
	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Content\**" />
		<EmbeddedResource Remove="Content\**" />
		<None Remove="Content\**" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Icon.ico" />
		<None Remove="Icon.bmp" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Icon.ico">
			<LogicalName>Icon.ico</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icon.bmp">
			<LogicalName>Icon.bmp</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Nopipeline.Task" Version="2.3.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\IdleEngine\IdleEngine.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\IdleCollector\PostProcesses\Bloom.cs" Link="PostProcesses\Bloom.cs" />
	</ItemGroup>
	<Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
		<Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
		<Exec Command="dotnet tool restore" />
	</Target>
	<Target Name="CopyIdleCollectorContent" BeforeTargets="Build">
		<ItemGroup>
			<ContentToCopy Include="..\IdleCollector\Content\**\*" />
		</ItemGroup>

		<Copy
			SourceFiles="@(ContentToCopy)"
			DestinationFiles="@(ContentToCopy->'Content\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true" />
	</Target>
	<ItemGroup>
		<NPLContentReferences Remove="Content\**" />
	</ItemGroup>
	<ItemGroup>
		<MGCBContentReferences Remove="Content\**" />
	</ItemGroup>
</Project>
